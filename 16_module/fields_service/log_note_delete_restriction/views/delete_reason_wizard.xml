<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delete_reason_wizard_form" model="ir.ui.view">
        <field name="name">delete.reason.wizard.form</field>
        <field name="model">delete.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Message">
                <group>
                    <field name="message_id" invisible="1"/>
                    <field name="reason" required="1" placeholder="Enter deletion reason..."/>
                </group>
                <footer>
                    <button name="action_confirm_delete" type="object" string="Delete" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
