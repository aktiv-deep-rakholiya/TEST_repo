<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_message_delete_log_tree" model="ir.ui.view">
        <field name="name">mail.message.deletion.log.tree</field>
        <field name="model">mail.message.deletion.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="deleted_on"/>
                <field name="deleted_by_id"/>
                <field name="model"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_message_delete_log_form" model="ir.ui.view">
        <field name="name">mail.message.deletion.log.form</field>
        <field name="model">mail.message.deletion.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="deleted_by_id"/>
                        <field name="deleted_on"/>
                        <field name="res_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                    <group>
                        <field name="original_body" widget="html"/>
                        <field name="model"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_message_delete_log" model="ir.actions.act_window">
        <field name="name">Deleted Message Audit</field>
        <field name="res_model">mail.message.deletion.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_deleted_message_audit"
        name="Deleted Message Audit"
        parent="mail.menu_root_discuss"
        action="action_message_delete_log"
        groups="base.group_system"
        sequence="999"/>

</odoo>